################################################################################
project:
  name: MagicSquare_xx
  domain: "4x4 Magic Square"
  goals:
    - "판정(유효성 판단 기준)을 명세/테스트/회귀 가능하게 고정"
    - "판정 안정화 이후 유효 배치 산출(확장 범위)"
  references:
    - "Report/01.ProblemDefinition_Report.md"
    - "Report/02.DualTrack_CleanArchitecture_Design_Report.md"
################################################################################
code_style:
  python_version: "3.10+"
  style_guide: "PEP8 엄격 준수"
  type_hints: "모든 함수 파라미터와 반환값에 필수"
  docstring: "Google 스타일, 모든 public 메서드에 필수"
  max_line_length: 88
################################################################################
architecture:
  pattern: "ECB (boundary/control/entity)"
  layers:
    boundary:
      definition: "외부 입출력 담당 (UI, API, CLI)"
      responsibilities:
        - "입력 파싱/검증(계약 수준)"
        - "출력 포맷/에러 스키마 표준화"
        - "외부 시스템(파일/네트워크/DB/콘솔) 연동"
    control:
      definition: "비즈니스 로직 담당"
      responsibilities:
        - "유스케이스 오케스트레이션"
        - "결정 규칙(흐름 제어) 구현"
        - "entity를 조합해 시나리오 수행"
    entity:
      definition: "도메인 데이터 및 규칙 담당"
      responsibilities:
        - "도메인 모델/불변조건 유지"
        - "순수 규칙(판정/검증) 제공"
        - "부작용 없는 계산 로직"
  dependency_direction:
    allowed:
      - "boundary -> control"
      - "control -> entity"
    forbidden:
      - "entity -> control"
      - "entity -> boundary"
      - "control -> boundary"
  constraints:
    - "entity는 파일/콘솔/네트워크/DB 등 외부 I/O에 의존하지 않는다."
    - "boundary는 도메인 규칙을 포함하지 않고 control을 통해 접근한다."
################################################################################
tdd_rules:
  red_phase:
    description: "테스트를 먼저 작성하고, 의도한 이유로 실패(RED)함을 확인한다."
    rules:
      - "테스트를 먼저 작성한다."
      - "새 테스트가 의도한 이유로 실패하는 것을 확인한다."
      - "실패 원인이 하나로 좁혀지도록 테스트를 최소화한다."
    must_not:
      - "RED 없이 프로덕션 코드를 작성/수정하지 않는다."
      - "테스트를 삭제/완화/skip/xfail 남용으로 RED를 숨기지 않는다."

  green_phase:
    description: "최소 코드로만 테스트를 통과(GREEN)시키고, 이 단계에서는 리팩터링하지 않는다."
    rules:
      - "테스트를 통과시키는 데 필요한 최소한의 코드만 작성한다."
      - "해당 변경과 무관한 일반화/최적화는 미룬다."
      - "전체 테스트가 GREEN인지 확인한다."
    must_not:
      - "이 단계에서 구조 개선 목적의 리팩터링을 하지 않는다."
      - "불필요한 추상화/아키텍처 확장을 하지 않는다."

  refactor_phase:
    description: "기능 변경 없이 구조만 개선하며, 커버리지/테스트 그린을 유지한다."
    rules:
      - "중복 제거, 네이밍 개선, 책임 분리 등 구조를 개선한다."
      - "전체 테스트가 계속 GREEN인지 수시로 확인한다."
      - "커버리지(및 핵심 경로 검증)가 유지되도록 한다."
    must_not:
      - "외부 동작(기능)을 바꾸지 않는다."
      - "테스트가 잡아내지 못하는 변경을 섞어 넣지 않는다."
      - "커버리지를 낮추거나 테스트를 약화시키지 않는다."
################################################################################
testing:
  framework: "pytest"
  pattern: "AAA (Arrange-Act-Assert)"
  coverage_minimum: "80%"
  fixture_scope:
    rules:
      - "기본은 function 스코프를 사용한다."
      - "session/module 스코프는 비용이 큰 설정(예: 임시 리소스)에서만 사용한다."
      - "fixture는 Arrange를 단순화하는 용도로만 쓰고, Assert 로직을 숨기지 않는다."
  naming_convention:
    rules:
      - "모든 테스트 함수는 test_ 접두사 필수"
      - "파일명은 test_*.py 형태를 권장"
################################################################################
forbidden:
  - pattern: "print()"
    reason: "테스트/실행 환경에서 출력이 노이즈가 되며, 디버깅이 코드에 남아 회귀를 유발한다."
    alternative: "pytest의 assert 메시지 강화, fixture 분해, parametrization, (필요 시) 로거 사용"
  - pattern: "하드코딩 상수(매직 넘버/문자열) 남발"
    reason: "규칙 변경/확장 시 수정 지점이 분산되고 의미가 불명확해진다."
    alternative: "상수는 entity의 Value Object/상수 모듈로 캡슐화하고 이름을 부여한다."
  - pattern: "except: (단독 사용)"
    reason: "SystemExit/KeyboardInterrupt 등까지 삼켜 오류를 숨기고, 테스트가 실패해야 할 상황을 통과시킨다."
    alternative: "구체 예외를 명시하고, 필요한 경우 예외를 재발생(raise)하거나 도메인 예외로 변환한다."
################################################################################
file_structure:
  # ECB 기준 폴더 구조(예시)
  # MagicSquare_xx/
  # ├─ boundary/
  # │  ├─ ui/
  # │  ├─ api/
  # │  └─ cli/
  # ├─ control/
  # ├─ entity/
  # └─ tests/
  #    ├─ boundary/
  #    ├─ control/
  #    └─ entity/
################################################################################
ai_behavior:
  pre_generation:
    - "코드 작성 전 관련 테스트 파일(또는 작성할 테스트 위치)을 먼저 확인한다."
    - "해당 변경이 boundary/control/entity 중 어디에 속하는지 먼저 결정한다."
    - "타입힌트 없는 함수/메서드를 생성하지 않는다."
  during_generation:
    - "ECB 레이어 경계를 위반하는 의존(역방향 import 등)을 만들지 않는다."
    - "tdd_rules의 현재 phase를 벗어나는 행동(예: GREEN에서 리팩터링)을 하지 않는다."
    - "테스트 약화로 GREEN을 만들지 않는다."
  post_generation:
    - "변경 후 테스트가 GREEN인지 확인하는 흐름을 우선한다."
    - "tdd_rules 위반이 감지되면 사용자에게 경고(채팅 출력)하고, 위반 없이 진행 가능한 대안을 제시한다."
